{
  "name": "sass-themes",
  "description": "themes is a Sass workaround that helps manipulating themes",
  "version": "0.1.0",
  "keywords": [
    "sass",
    "themes"
  ],
  "ignore": [
    "sassdoc",
    "example",
    "**/.*"
  ],
  "files": [
    "_themes.scss",
    "LICENSE",
    "README.md"
  ],
  "main": "_themes.scss",
  "scripts": {
    "test": "jest",
    "sassdoc": "./scripts/sassdoc.sh",
    "build:examples": "sass ./examples:./examples --no-source-map"
  },
  "contributors": [
    {
      "name": "",
      "email": "",
      "web": ""
    }
  ],
  "bugs": {
    "url": "https://github.com/oa-evseev/sass-themes/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oa-evseev/sass-themes.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/oa-evseev/sass-themes/",
  "devDependencies": {
    "sass": "^1.64.2",
    "sassdoc": "^2.7.4"
  }
}

{
  "name": "sass-themes",
  "description": "Generic build-time Sass theme compiler with runtime CSS variable overrides",
  "version": "1.0.0",
  "keywords": [
    "sass",
    "themes"
  ],
  "ignore": [
    "example",
    "**/.*"
  ],
  "files": [
    "_themes.scss",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "main": "_themes.scss",
  "scripts": {
    "test": "node test/run.mjs",
    "build:examples": "sass test/fixtures:build/examples --no-source-map",
    "test:deprecations": "sass --fatal-deprecation=global-builtin --no-source-map test/fixtures:build/test"
  },
  "contributors": [
    {
      "name": "",
      "email": "",
      "web": ""
    }
  ],
  "bugs": {
    "url": "https://github.com/oa-evseev/sass-themes/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oa-evseev/sass-themes.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/oa-evseev/sass-themes/",
  "devDependencies": {
    "sass": "1.102.0"
  }
}
